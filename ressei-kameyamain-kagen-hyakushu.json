 ],
 "poems": [
  {
   "seq": "1",
   "text": "かくしつつ身はふりまさる宿にさて年新しく春ぞたちける",
   "kana": "",
   "speaker": "",
   "page": 224,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "山風はなほさむからしみよし野の吉野の里はかすみそむれど",
   "kana": "",
   "speaker": "",
   "page": 224,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "朝嵐に枝は氷れるみ山木の花まちつけぬはるのあわ雪",
   "kana": "",
   "speaker": "すき夜を猶こめてねぐらの枝にうつる鶯",
   "page": 225,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "うちむれて人は行くとも身をしればわれ老らくに若菜つまめや",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "移りける匂や袖にふかからむ軒ばの梅の花のしたかぜ",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "おしなべて咲かぬ垣ねもかをりつつよそにみちたる梅の下風",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "春風に柳の絲をみだるともかたよりならぬ心とをしれ",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "殘りつる身の行末を思ふにも心細くもはるさめぞふる",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "北にとぶ翼こそあらめ聲さへに哀をそへぬはるのかりがね",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "咲きぬやと思ふよりかつ忘られで心ぐるしき山ざくらかな",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "かつさきてまたるる色もめづらしくたえだえみゆる花のむら雲",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "山のはに入日うつろふ紅のうす花ざくら色ぞことなる",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "春かぜにさきぬる花の宮木守こころゆるすなやどのさくらを",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "命にもかへばやとおもふ心をばしらでや花のやすくちるらむ",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "あかでなほくれゆく春の色とめて花の枝もるいざよひの月",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "池水の綠も松にしたそへて梢にかかるきしのふぢなみ",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "山吹のたがあやまちに咲き初めて多をばよそのいろ〓なしけむ",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "つくづくと彌生の頃の長き日もかぎりありてや春のくれぬる",
   "kana": "",
   "speaker": "",
   "page": 225,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "時鳥なきぬとつぐる人のこゑにまことの鳥のねぞまたれける",
   "kana": "",
   "speaker": "",
   "page": 226,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "わすれずよ右のつかさの袖ふれし花橘やいまかをるらむ",
   "kana": "",
   "speaker": "",
   "page": 226,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "をしからぬ身を思ふにもかへなばや數みえてとぶよはの螢に",
   "kana": "",
   "speaker": "",
   "page": 226,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "凉しさやかつがつ下にかよふらむ岩こす水のあきのこころは",
   "kana": "",
   "speaker": "",
   "page": 226,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "いせの海星合のあまの名ばかりにこよひぞなみのよるの契は",
   "kana": "",
   "speaker": "",
   "page": 226,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "夕ぐれは結びやあまる置く露のしろき麻ぎぬま袖せばくて",
   "kana": "",
   "speaker": "",
   "page": 227,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "いとときたおりてぞまさる秋秋の花色ごろもつゆのたてぬき",
   "kana": "",
   "speaker": "",
   "page": 227,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "そよ更にあはれそへける風の音も秋をこめたる庭のをぎ原",
   "kana": "",
   "speaker": "",
   "page": 227,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "つゆかろきひとむら薄ほのかにも夕は誰れが袖とみゆらむ",
   "kana": "",
   "speaker": "",
   "page": 227,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "秋といへば物思へとはむかしよりたがさだめたる夕ぐれの空",
   "kana": "",
   "speaker": "",
   "page": 227,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "われのみと秋のひと夜を心にて世をはばからぬむしの聲かな",
   "kana": "",
   "speaker": "",
   "page": 227,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "つたへける山はあらしのわが宿となれてもあかぬさをしかのこゑ",
   "kana": "",
   "speaker": "",
   "page": 227,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "さしていつとたのめぬ物の大空にかならずくるは秋の雁がね",
   "kana": "",
   "speaker": "",
   "page": 227,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "山のはにいでぬ光をさきだてて西こそ月のかげは見えけれ",
   "kana": "",
   "speaker": "",
   "page": 227,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "しばしだに心くもらぬ人もがな空なる月のはれ〓きよに",
   "kana": "",
   "speaker": "",
   "page": 227,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "花もをし紅葉もふかき色なれどよなよなみてもあかぬ月影",
   "kana": "",
   "speaker": "",
   "page": 227,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "見る人の心にまづぞかかりける月のあたりの夜半の浮雲",
   "kana": "",
   "speaker": "",
   "page": 227,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "しもとなる秋も有明の末の露もとみし心たれもしらじな",
   "kana": "",
   "speaker": "",
   "page": 227,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "かりそめの賤が伏屋のひまをあらみ夜風さむしと衣うつなり",
   "kana": "",
   "speaker": "",
   "page": 227,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "濱千鳥ひとのこころもこと浦にむかしのあとをなくなくぞ行く",
   "kana": "",
   "speaker": "",
   "page": 228,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "かぎりある老はつもれる年の暮をよろこぶ人の身にはなきかな",
   "kana": "",
   "speaker": "",
   "page": 228,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "いひふるすことは違ひて今年こそ年ゆたかにて雪はつもらね",
   "kana": "",
   "speaker": "",
   "page": 228,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "はげしくて夢をもやぶる風の音に霰ふるよは更にねられず",
   "kana": "",
   "speaker": "",
   "page": 228,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "白妙の松のうは葉をみがきつつ雪をいただく山のはの月",
   "kana": "",
   "speaker": "",
   "page": 228,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "そめいでて木のはもあらし吹きすぎて空しき枝に時雨ふるなり",
   "kana": "",
   "speaker": "",
   "page": 228,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "野べの色まがきの菊のうつろひも冬まで霜ぞむすびとめける",
   "kana": "",
   "speaker": "",
   "page": 228,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "折りて見し紅葉の色にまさりけり唐錦なる山のしたみち",
   "kana": "",
   "speaker": "",
   "page": 228,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "秋の色は九つわうてすぎぬなり殘も一夜のかげぞこひしき",
   "kana": "",
   "speaker": "",
   "page": 228,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "はれくもりいくしほまでと夕時雨ぬれてそめほす山の紅葉ば",
   "kana": "",
   "speaker": "",
   "page": 228,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "立田姫しぐれに色は見えねどもいかに紅葉をちぢにそむらむ",
   "kana": "",
   "speaker": "",
   "page": 228,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "かくとだにいぶきの山のいたづらにさしも思にもえそめにけり",
   "kana": "",
   "speaker": "",
   "page": 229,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "更にまた戀ひずぞあらむあぢきなく人目をそへて包む思は",
   "kana": "",
   "speaker": "",
   "page": 229,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "よそならぬみをばかへして恨むべき我れにつれなき人の心に",
   "kana": "",
   "speaker": "",
   "page": 229,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "思川末のあふせは渡るともまたでや消えむ波のうたかた",
   "kana": "",
   "speaker": "",
   "page": 229,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "行末をたのむばかりに程やへむ猶かた絲のよるべならねば",
   "kana": "",
   "speaker": "",
   "page": 229,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "あやにくにあはぬ夜がれのつもるより賴むる暮をまつや苦しき",
   "kana": "",
   "speaker": "",
   "page": 229,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "たのめおくしるしもみえぬ夕暮はすぎのはかへて松風ぞふく",
   "kana": "",
   "speaker": "",
   "page": 229,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "ことのはもあひみそめては忘られぬ嬉しさばかり身にとまりつつ",
   "kana": "",
   "speaker": "",
   "page": 229,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "めづらしや逢ふとばかりの名のみして枕かはさぬ鳥のねぞきく",
   "kana": "",
   "speaker": "",
   "page": 229,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "みしは夢つらさは今の現にて忘れずながらあはぬ頃かな",
   "kana": "",
   "speaker": "",
   "page": 229,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "たちかへり待つよながらのあらましに別れし鳥のねもや變らむ",
   "kana": "",
   "speaker": "",
   "page": 229,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "面影も今やいかにとなるみ潟しほひは遠くなりまさりつつ",
   "kana": "",
   "speaker": "",
   "page": 229,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "忍びしに思ひしらせよ忘るるも同じたねまく人のこころは",
   "kana": "",
   "speaker": "",
   "page": 230,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "みくさゐる野中にみゆる忘水たえまたえまは流れだにせず",
   "kana": "",
   "speaker": "",
   "page": 230,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "なかなかに人の人とも思はねば身を身にてしるうらみだになし",
   "kana": "",
   "speaker": "",
   "page": 230,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "しづかなる寐覺よ深き曉のかねよりつづくとりのこゑごゑ",
   "kana": "",
   "speaker": "き",
   "page": 230,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "徒にみののを山のまつこともなき我れながら年ふりにけり",
   "kana": "",
   "speaker": "",
   "page": 230,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "人こえにうきふしもなし吳竹の世のことしらぬ身はやすくして",
   "kana": "",
   "speaker": "",
   "page": 230,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "ききてのみ現にはみぬうつの山ゆめにも見えず蔦の細道",
   "kana": "",
   "speaker": "",
   "page": 230,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "絕えせじなのちのうが野の行末をとみの小川のながれあまたに",
   "kana": "",
   "speaker": "",
   "page": 230,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "きき渡る我が身ながらも耻しや橋ばしらさへくち殘る世に",
   "kana": "",
   "speaker": "",
   "page": 230,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "遠くとも賴む心はかよふらむ關のかための動きなきよに",
   "kana": "",
   "speaker": "",
   "page": 230,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "終にすむやどりならねば野も山もいづく旅ねの心地こそせね",
   "kana": "",
   "speaker": "",
   "page": 230,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "かりそめの草ひき結ぶ旅ねにもわすれぬものを妹が手枕",
   "kana": "",
   "speaker": "",
   "page": 230,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "わたつみのさすが舟路もしらぬ哉花のみやこのあるじのみして",
   "kana": "",
   "speaker": "",
   "page": 230,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "かしこきも身の上しらずよそにてぞ愚かなる人に誠とふべき",
   "kana": "",
   "speaker": "",
   "page": 231,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "秋はてし山田のなるこ庵あれてひく人なしにいかが世にふる",
   "kana": "",
   "speaker": "",
   "page": 231,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "おくことは違はず神もきけ我がすべらぎの千代の行末",
   "kana": "",
   "speaker": "",
   "page": 231,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "尾の山は萬代こゑたてて河はちとせに一たびぞすむ",
   "kana": "",
   "speaker": "",
   "page": 231,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "かは事ありがほにいひなして心の外の道もとむらむ",
   "kana": "",
   "speaker": "",
   "page": 231,
   "pid": "945300",
   "form": "短歌",
   "genre": ""
  }
 ],
 "catalog": {
